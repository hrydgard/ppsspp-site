<!doctype html>

<html lang="en" data-theme="dark">

<head>
    <meta charset="UTF-8">
    {{!-- Browser UI color = header color (--color-header-footer-background in vars.css). It follows the
         site theme, not prefers-color-scheme, since the site is dark unless you pick light. --}}
    <meta name="theme-color" content="#000000">
    {{!-- Apply the saved theme before anything renders, to avoid a dark flash for light-theme users.
         main.js (switchTheme) writes it and keeps theme-color in sync. --}}
    <script>try { var t = localStorage.getItem('theme'); if (t) { document.documentElement.dataset.theme = t; if (t === 'light') document.querySelector('meta[name=theme-color]').content = '#ffffff'; } } catch (e) { }</script>

    {{!-- page_title (src/main.rs) appends " – PPSSPP" unless the title already has it. --}}
    <title>{{page_title title}}</title>

    <meta name="description" content="{{description}}">
    <meta name="keywords" content="PSP, emulator">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{#if noIndex}}
    <meta name="robots" content="noindex">
    {{else if canonical_url}}
    <link rel="canonical" href="{{canonical_url}}">
    {{/if}}

    <meta property="og:site_name" content="PPSSPP">
    <meta property="og:title" content="{{title}}">
    <meta property="og:description" content="{{description}}">
    <meta property="og:type" content="{{og_type}}">
    {{#unless noIndex}}{{#if canonical_url}}<meta property="og:url" content="{{canonical_url}}">{{/if}}{{/unless}}
    {{!-- TODO: a 1200x630 share image, then switch twitter:card to summary_large_image. --}}
    <meta property="og:image" content="https://www.ppsspp.org/icon-512.png">
    <meta name="twitter:card" content="summary">

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PEQLDV0155"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-PEQLDV0155');
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" sizes="16x16 32x32" href="/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png">
    <link rel="manifest" href="/manifest.webmanifest">


    <link rel="stylesheet" type="text/css" href="/static/css/all.css?v={{globals.asset_v.all_css}}">
    <link rel="alternate" type="application/rss+xml" href="/news/rss.xml" title="PPSSPP RSS Feed">
    <link rel="alternate" type="application/atom+xml" href="/news/atom.xml" title="PPSSPP Atom Feed">
    {{#if pagination.newer_url}}<link rel="prev" href="{{pagination.newer_url}}">{{/if}}
    {{#if pagination.older_url}}<link rel="next" href="{{pagination.older_url}}">{{/if}}

    <script src="/static/script/squirrelly.min.js?v={{globals.asset_v.squirrelly_js}}" defer></script>
    <script src="/static/script/main.js?v={{globals.asset_v.main_js}}" defer></script>

    {{#unless noAds}}
    {{!-- No ads for Gold users. Login state is cached in localStorage by main.js
         (processLoginData), so we can check it before loading the ad script. --}}
    <script>
        (function () {
            var gold = false;
            try {
                var auth = JSON.parse(localStorage.getItem('ppsspp-auth'));
                gold = !!(auth && auth.goldUser);
            } catch (e) { }
            if (gold) {
                document.documentElement.classList.add('no-ads');
                return;
            }
            var s = document.createElement('script');
            s.async = true;
            s.crossOrigin = 'anonymous';
            s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3281131109267988';
            document.head.appendChild(s);
        })();
    </script>
    {{else}}
    <script>document.documentElement.classList.add('no-ads');</script>
    {{/unless}}

    {{!-- Special behaviors. There's probably a better way. --}}
    <script>
        var g_loginByKey = false;
        var g_thankYouPage = false;
        var g_downloadPage = false;
        var g_buildbotPage = false;
    </script>

    {{#if fastspring}}
    <script id="fsc-api" src="https://d1f8f9xcsvx3ha.cloudfront.net/sbl/0.7.4/fastspring-builder.min.js"
        {{#if globals.prod}} data-storefront="ppsspp.onfastspring.com/popup-gold"
        {{else}} data-storefront="ppsspp.test.onfastspring.com/popup-gold" {{/if}}
        data-popup-closed="onFSPopupClosed" data-error-callback="onFSError" {{#unless globals.prod}}data-debug=true{{/unless}}></script>
    {{/if}}

    {{#if contains_code}}
    <script src="/static/script/highlight.min.js?v={{globals.asset_v.highlight_js}}" defer></script>
    {{/if}}
</head>

<body>
    <div class="page-wrapper">
        <header role="banner">
            <nav aria-label="Header" class="top-nav">
                <button type="button" id="burgerButton" aria-label="Toggle mobile navigation" class="menu-button"
                        onclick="burgerClick()">
                    <div class="menu-icon"></div>
                </button>

                <div class="top-nav-logo">
                    <a href="/" class="center-vertical"><img id="navbarIcon" src="/static/img/platform/ppsspp-icon.png" alt="" aria-hidden="true"
                            width="32" height="32" class="icon">PPSSPP</a>
                </div>

                <ul class="menu">
                    {{#each top_nav}}
                    <li {{#if external}}class="external"{{/if}}>
                        <a href="{{url}}" {{#if selected}}class="selected"{{/if}}>{{{title}}}{{#if external}}{{>link_icon}}{{/if}}</a>
                    </li>
                    {{/each}}
                    <li>
                        <button type="button" aria-label="Switch theme" onclick="switchTheme()">
                            <i aria-hidden="true" class="icon-ui icon-ui-moon"></i>
                        </button>
                    </li>
                </ul>

                <div id="loginCorner" class="center-vertical"><a href="/login">Login</a></div>
            </nav>

            <nav id="rootSidebar" aria-label="Mobile" class="burger-sidebar hidden">
                {{!-- We repeat all the same stuff again, but add Login. Better than crazy CSS tricks... --}}
                <ul class="burger-menu">
                    {{#each top_nav}}
                    <li><a href="{{url}}" {{#if selected}}class="selected"{{/if}}>{{{title}}}{{#if external}}{{>link_icon}}{{/if}}</a></li>
                    {{/each}}
                    <li>
                        <div id="loginItem"><a href="/login">Login</a></div>
                    </li>
                    <li>
                        <button type="button" onclick="switchTheme()">
                            <i aria-hidden="true" class="icon-ui icon-ui-moon sp-right"></i>Switch Theme</button>
                    </li>
                </ul>
            </nav>
        </header>

        <main role="main" class="contents">