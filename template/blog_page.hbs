{{>common_header this}}

<div class="doc-container">
    <aside role="complementary" class="doc-sidebar" id="localSidebar">
        {{{sidebar}}}
        <div class="feed-links">
            <a href="/{{meta.section}}/atom.xml"><img src="/static/img/rss.png" alt="Atom feed" width="24" height="24" class="icon"></a>
        </div>
    </aside>

    <div class="doc-contents">
        {{#if tags}}
        <nav aria-labelledby="doc-tags" class="doc-tagbar">
            <span id="doc-tags">Tags:</span>
            <ul class="tag-list">
                {{#each tags}}
                <li {{#if selected}}class="selected"{{/if}}>
                    <a class="tag-link" href="/{{../meta.section}}/tags/{{name}}">{{name}}</a>
                </li>
                {{/each}}
            </ul>
        </nav>
        {{/if}}

        {{{contents}}}

        {{>unit}}

        {{#if pagination}}
        <nav aria-label="Pages" class="pager">
            {{#if pagination.newer_url}}<a href="{{pagination.newer_url}}" class="pager-step" rel="prev">&laquo;&nbsp;Newer</a>{{/if}}
            <ul class="pager-pages">
                {{#each pagination.pages}}
                {{#if number}}
                <li>{{#if current}}<span aria-current="page">{{number}}</span>{{else}}<a href="{{url}}">{{number}}</a>{{/if}}</li>
                {{else}}
                <li class="gap">&hellip;</li>
                {{/if}}
                {{/each}}
            </ul>
            {{#if pagination.older_url}}<a href="{{pagination.older_url}}" class="pager-step" rel="next">Older&nbsp;&raquo;</a>{{/if}}
        </nav>
        {{else}}
        <nav aria-label="Post" class="nav-link-container">
            {{#if meta.prev}}
            <a href="{{meta.prev.url}}" class="nav-link">
                <div class="direction">Prev</div>
                <div class="title">&laquo;&nbsp;{{meta.prev.title}}</div>
            </a>
            {{/if}}
            {{#if meta.next}}
            <a href="{{meta.next.url}}" class="nav-link next">
                <div class="direction">Next</div>
                <div class="title">{{meta.next.title}}&nbsp;&raquo;</div>
            </a>
            {{/if}}
        </nav>
        {{/if}}
    </div>
</div>

{{>common_footer this}}